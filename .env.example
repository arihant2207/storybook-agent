# ==============================================================================
# Storybook Agent Environment Variables
# Copy this file to .env and fill in your values
# ==============================================================================

# Required: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
# Model Configuration (SPEC section 4: text, vision, image models)
TEXT_MODEL=gemini-3.8-flash
VISION_MODEL=gemini-3.8-flash
IMAGE_MODEL=imagen-3.0-generate-002

# Fixed style suffix used across all illustrations for visual consistency
STYLE_SUFFIX=charming children's book illustration, vibrant watercolor and soft digital painting, warm lighting, whimsical storybook aesthetic, clean lines, high detail, masterpiece
